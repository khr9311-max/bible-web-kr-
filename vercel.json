{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/css/(.*)", "destination": "/public/css/$1" },
    { "source": "/js/(.*)", "destination": "/public/js/$1" },
    { "source": "/icons/(.*)", "destination": "/public/icons/$1" },
    { "source": "/manifest.json", "destination": "/public/manifest.json" },
    { "source": "/sw.js", "destination": "/public/sw.js" },
    { "source": "/(.*)", "destination": "/public/index.html" }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "server/data/**"
    }
  }
}
